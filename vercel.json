{
    "headers": [
        {
            "source": "/(.*).(zip)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/zip"
                },
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        }
    ]
}